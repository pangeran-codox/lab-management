APP_NAME=Lab Management
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

TELESCOPE_ENABLED=true
TELESCOPE_PRUNE_HOURS=24

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ──────────────────────────────────────────────────────────
# Database Configuration
# ──────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lab_management
DB_USERNAME=postgres
DB_PASSWORD=

# Finance Database (Optional, for finance module)
DB_FINANCE_HOST=127.0.0.1
DB_FINANCE_PORT=5432
DB_FINANCE_DATABASE=finance
DB_FINANCE_USERNAME=postgres
DB_FINANCE_PASSWORD=

# ──────────────────────────────────────────────────────────
# Redis Configuration
# ──────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis
REDIS_DB=0
REDIS_CACHE_DB=1

# ──────────────────────────────────────────────────────────
# Broadcasting & Reverb (WebSocket)
# ──────────────────────────────────────────────────────────
BROADCAST_DRIVER=reverb
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Laravel Reverb
REVERB_APP_ID=lab-management
REVERB_APP_KEY=lab-management-key
REVERB_APP_SECRET=lab-management-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=*

# ──────────────────────────────────────────────────────────
# MikroTik & Bot Configuration
# ──────────────────────────────────────────────────────────
MIKROTIK_HOST=103.182.235.42
MIKROTIK_PORT=2112
MIKROTIK_USER=admin
MIKROTIK_PASS=m41k3l

BOT_TOKEN=your-bot-token-here
BOT_WEBHOOK_URL=
BOT_URL=http://170.1.0.9:5000

# ──────────────────────────────────────────────────────────
# Mail Configuration
# ──────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ──────────────────────────────────────────────────────────
# AWS S3 (Optional)
# ──────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ──────────────────────────────────────────────────────────
# Vite Configuration
# ──────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
